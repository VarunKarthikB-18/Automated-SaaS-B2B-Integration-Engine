# ============================================================
#  B2B SaaS Integration Engine – Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit the real .env file to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
#
# LOCAL DEVELOPMENT (default – no Docker or Postgres needed)
# Leave DATABASE_URL and all POSTGRES_* vars commented out to
# automatically use a local SQLite file: sqlite:///./test.db
#
# DATABASE_URL=sqlite:///./test.db

# PRODUCTION – uncomment ONE of the blocks below:

# Option A: full connection string (Heroku / Railway / Render)
# DATABASE_URL=postgresql://b2b_user:b2b_password@localhost:5432/b2b_integration

# Option B: individual vars (Docker Compose)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=b2b_integration
# POSTGRES_USER=b2b_user
# POSTGRES_PASSWORD=b2b_password

# ── Google Gemini (LLM column mapping) ───────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
# Leave blank to disable LLM mapping (rule-based fallback used)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── App settings ─────────────────────────────────────────────
LOG_LEVEL=info
# Set SQL_ECHO=true to print all raw SQL queries to the console
SQL_ECHO=false
